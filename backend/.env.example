# Database
DATABASE_URL=postgresql://iot_user:iot_password@db:5432/iot_monitoring
POSTGRES_USER=iot_user
POSTGRES_PASSWORD=iot_password
POSTGRES_DB=iot_monitoring

# JWT
JWT_SECRET_KEY=change_this_to_a_long_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MQTT
MQTT_BROKER_HOST=mqtt-broker
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=iot/devices

# App
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEVICE_OFFLINE_TIMEOUT_SECONDS=120
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=5
